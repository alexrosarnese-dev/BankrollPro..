<!DOCTYPE html>
<html lang="it" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="BankrollPro" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="theme-color" content="#0f172a" />
  <title>BankrollPro - Gestione Bankroll & Scommesse</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            slate: {
              850: '#162032',
              900: '#0f172a',
              950: '#090d16',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #090d16;
      color: #f8fafc;
      -webkit-tap-highlight-color: transparent;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      opacity: 1;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-emerald-500/30 selection:text-emerald-200">

  <!-- Navbar -->
  <header class="sticky top-0 z-30 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/20">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold tracking-tight text-white leading-none">Bankroll<span class="text-emerald-400">Pro</span></h1>
          <p class="text-[11px] text-slate-400 hidden sm:block">Gestione Capitale & Money Management</p>
        </div>
      </div>

      <!-- Azioni rapide -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <button id="install-pwa-btn" onclick="installPWA()" class="hidden px-2.5 sm:px-3 py-1.5 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 text-xs font-semibold text-emerald-300 transition" title="Installa App">
          Installa
        </button>

        <button onclick="openBankrollModal()" class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition flex items-center gap-1.5" title="Imposta Bankroll Iniziale">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Capitale</span>
        </button>

        <button onclick="exportCSV()" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition" title="Esporta CSV">
          CSV
        </button>

        <button onclick="exportJSON()" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition" title="Backup JSON">
          Backup
        </button>

        <label class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition cursor-pointer" title="Ripristina Backup JSON">
          Importa
          <input type="file" accept=".json" onchange="importJSON(event)" class="hidden" />
        </label>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- KPI Cards -->
    <section class="grid grid-cols-2 lg:grid-cols-6 gap-3 sm:gap-4">
      <div class="col-span-2 lg:col-span-2 bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 flex flex-col justify-between relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium uppercase tracking-wider text-slate-400">Bankroll Attuale</span>
          <span id="kpi-initial-badge" class="text-[11px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">Iniziale: €1.000,00</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span id="kpi-bankroll" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">€1.000,00</span>
        </div>
        <div class="mt-2 flex items-center gap-2 text-xs">
          <span id="kpi-growth" class="font-semibold text-emerald-400">+0,00%</span>
          <span class="text-slate-500">rispetto al capitale iniziale</span>
        </div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Profitto Netto</span>
        <div id="kpi-profit" class="text-xl sm:text-2xl font-bold text-slate-100 mt-1">€0,00</div>
        <div id="kpi-staked" class="text-[11px] text-slate-500 mt-1">Giocato: €0,00</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Yield %</span>
        <div id="kpi-yield" class="text-xl sm:text-2xl font-bold text-slate-100 mt-1">0,00%</div>
        <div id="kpi-roi" class="text-[11px] text-slate-500 mt-1">ROI Bankroll: 0,00%</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Win Rate</span>
        <div id="kpi-winrate" class="text-xl sm:text-2xl font-bold text-slate-100 mt-1">0,0%</div>
        <div id="kpi-record" class="text-[11px] text-slate-500 mt-1">0V - 0P - 0R</div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Quota Media</span>
        <div id="kpi-avgodds" class="text-xl sm:text-2xl font-bold text-slate-100 mt-1">0.00</div>
        <div id="kpi-pending" class="text-[11px] text-amber-400/90 mt-1">In corso: €0,00</div>
      </div>
    </section>

    <!-- Chart + Nuova Giocata + Calcolatore Kelly -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Left Column: Form Scommessa & Kelly (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Nuova Scommessa
            </h2>
            <span id="stake-pct-label" class="text-xs font-medium text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">2.0% del bankroll</span>
          </div>

          <form id="bet-form" onsubmit="addBet(event)" class="space-y-3.5">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Data</label>
                <input type="date" id="bet-date" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Sport</label>
                <select id="bet-sport" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                  <option value="Calcio">⚽ Calcio</option>
                  <option value="Tennis">🎾 Tennis</option>
                  <option value="Basket">🏀 Basket</option>
                  <option value="Motori">🏎️ Motori</option>
                  <option value="Esports">🎮 Esports</option>
                  <option value="Altro">🏆 Altro</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Evento / Partita</label>
              <input type="text" id="bet-event" placeholder="es. Inter - Milan" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Pronostico / Mercato</label>
              <input type="text" id="bet-selection" placeholder="es. 1X + Over 1.5" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Quota</label>
                <input type="number" id="bet-odds" step="0.01" min="1.01" placeholder="1.85" required oninput="updateStakeIndicator()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Puntata (€)</label>
                <input type="number" id="bet-stake" step="0.01" min="0.10" placeholder="20.00" required oninput="updateStakeIndicator()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
              </div>
            </div>

            <div class="flex items-center justify-between gap-1.5 pt-0.5">
              <span class="text-[11px] text-slate-500">Stake rapido:</span>
              <div class="flex gap-1.5">
                <button type="button" onclick="setPercentStake(1)" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 transition">1%</button>
                <button type="button" onclick="setPercentStake(2)" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 transition">2%</button>
                <button type="button" onclick="setPercentStake(3)" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 transition">3%</button>
                <button type="button" onclick="setPercentStake(5)" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-300 transition">5%</button>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Bookmaker</label>
                <input type="text" id="bet-bookie" placeholder="es. Bet365, Sisal..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Esito Iniziale</label>
                <select id="bet-status" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                  <option value="pending">⏳ In corso</option>
                  <option value="won">✅ Vinta</option>
                  <option value="lost">❌ Persa</option>
                  <option value="void">🔄 Rimborsata (Void)</option>
                </select>
              </div>
            </div>

            <button type="submit" class="w-full mt-2 py-2.5 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-semibold text-sm shadow-lg shadow-emerald-500/20 transition">
              + Registra Scommessa
            </button>
          </form>
        </div>

        <!-- Calcolatore Criterio di Kelly -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-bold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
              Calcolatore Criterio di Kelly
            </h2>
            <span class="text-[11px] text-slate-400">Value Betting</span>
          </div>

          <div class="grid grid-cols-3 gap-2.5 mb-3">
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Quota</label>
              <input type="number" id="kelly-odds" step="0.01" min="1.01" value="2.10" oninput="calculateKelly()" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-sm text-white focus:outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Prob. Reale (%)</label>
              <input type="number" id="kelly-prob" step="0.5" min="1" max="99" value="52" oninput="calculateKelly()" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-sm text-white focus:outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="block text-[11px] text-slate-400 mb-1">Frazione</label>
              <select id="kelly-fraction" onchange="calculateKelly()" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-2 py-1.5 text-sm text-white focus:outline-none focus:border-sky-500">
                <option value="1">Full (100%)</option>
                <option value="0.5" selected>Half (50%)</option>
                <option value="0.25">Quarter (25%)</option>
              </select>
            </div>
          </div>

          <div class="bg-slate-950 border border-slate-800/80 rounded-xl p-3 flex items-center justify-between">
            <div>
              <div class="text-[11px] text-slate-400">Valore Atteso (EV): <span id="kelly-ev" class="font-semibold text-emerald-400">+9.20%</span></div>
              <div class="text-xs text-slate-300 mt-0.5">Puntata consigliata: <span id="kelly-stake" class="font-bold text-white">€41,82</span> <span id="kelly-pct" class="text-slate-400">(4.18%)</span></div>
            </div>
            <button type="button" onclick="applyKellyToForm()" class="px-3 py-1.5 rounded-lg bg-sky-500/15 hover:bg-sky-500/25 border border-sky-500/30 text-sky-300 text-xs font-semibold transition">
              Usa
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Equity Chart & Storico (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <div>
              <h2 class="text-base font-bold text-white">Andamento Bankroll (Equity Curve)</h2>
              <p class="text-xs text-slate-400">Evoluzione del capitale giocata dopo giocata</p>
            </div>
            <div id="chart-badge" class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              In pari
            </div>
          </div>
          <div class="relative h-64 sm:h-72 w-full">
            <canvas id="bankrollChart"></canvas>
          </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
            <h2 class="text-base font-bold text-white">Storico Scommesse</h2>
            <div class="flex flex-wrap items-center gap-2">
              <input type="text" id="filter-search" placeholder="Cerca evento..." oninput="renderBets()" class="bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 w-36 sm:w-44" />
              <select id="filter-status" onchange="renderBets()" class="bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500">
                <option value="all">Tutti gli esiti</option>
                <option value="pending">⏳ In corso</option>
                <option value="won">✅ Vinte</option>
                <option value="lost">❌ Perse</option>
                <option value="void">🔄 Rimborsate</option>
              </select>
              <select id="filter-sport" onchange="renderBets()" class="bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500">
                <option value="all">Tutti gli sport</option>
                <option value="Calcio">Calcio</option>
                <option value="Tennis">Tennis</option>
                <option value="Basket">Basket</option>
                <option value="Motori">Motori</option>
                <option value="Esports">Esports</option>
                <option value="Altro">Altro</option>
              </select>
            </div>
          </div>

          <div class="overflow-x-auto -mx-5 px-5">
            <table class="w-full text-left border-collapse min-w-[620px]">
              <thead>
                <tr class="border-b border-slate-800 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                  <th class="py-2.5 pr-3">Data / Sport</th>
                  <th class="py-2.5 px-3">Evento & Pronostico</th>
                  <th class="py-2.5 px-3 text-right">Quota</th>
                  <th class="py-2.5 px-3 text-right">Puntata</th>
                  <th class="py-2.5 px-3 text-right">P/L</th>
                  <th class="py-2.5 pl-3 text-right">Stato / Azioni</th>
                </tr>
              </thead>
              <tbody id="bets-table-body" class="divide-y divide-slate-800/60 text-sm"></tbody>
            </table>
          </div>

          <div id="empty-state" class="hidden py-10 text-center">
            <p class="text-sm text-slate-400">Nessuna scommessa trovata con i filtconst CACHE_NAME = 'bankrollpro-cache-v1';
const CORE_ASSETS = [
  './',
  './index.html',
  'https://cdn.tailwindcss.com',
  'https://cdn.jsdelivr.net/npm/chart.js'
];

self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then((cache) => {
      return Promise.allSettled(
        CORE_ASSETS.map((url) => cache.add(url))
      );
    })
  );
  self.skipWaiting();
});

self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys().then((keys) =>
      Promise.all(
        keys
          .filter((key) => key !== CACHE_NAME)
          .map((key) => caches.delete(key))
      )
    )
  );
  self.clients.claim();
});

self.addEventListener('fetch', (event) => {
  if (event.request.method !== 'GET') return;

  const url = new URL(event.request.url);
  if (!url.protocol.startsWith('http')) return;

  event.respondWith(
    caches.match(event.request).then((cachedResponse) => {
      const fetchPromise = fetch(event.request)
        .then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const responseClone = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => {
              cache.put(event.request, responseClone);
            });
          }
          return networkResponse;
        })
        .catch(() => cachedResponse);

      return cachedResponse || fetchPromise;
    })
  );
});
